<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tv_title_yr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/inter"
            android:text="@string/title_main"
            android:textColor="@color/gold"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_subtitle_yr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/inter"
            android:text="@string/subtitle_registration"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_label_name_yr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="@string/label_name"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/et_name_yr"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/inter"
                android:hint="@string/hint_name"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_gray" />

            <TextView
                android:id="@+id/tv_label_birth_yr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter"
                android:text="@string/label_birth"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/et_birth_yr"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/inter"
                android:hint="@string/hint_birth"
                android:inputType="number"
                android:maxLength="4"
                android:paddingHorizontal="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_gray" />

            <TextView
                android:id="@+id/tv_label_dest_yr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter"
                android:text="@string/label_dest"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/et_dest_yr"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/inter"
                android:hint="@string/hint_dest"
                android:inputType="number"
                android:maxLength="4"
                android:paddingHorizontal="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/hint_gray" />

            <TextView
                android:id="@+id/tv_label_purpose_yr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter"
                android:text="@string/label_purpose"
                android:textColor="@color/white" />

            <RadioGroup
                android:id="@+id/rg_purpose_yr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_tourism_yr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/gold"
                    android:fontFamily="@font/inter"
                    android:text="@string/purpose_tourism"
                    android:textColor="@color/white" />

                <RadioButton
                    android:id="@+id/rb_modify_past_yr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/gold"
                    android:fontFamily="@font/inter"
                    android:text="@string/purpose_modify_past"
                    android:textColor="@color/white" />

                <RadioButton
                    android:id="@+id/rb_escape_yr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/gold"
                    android:fontFamily="@font/inter"
                    android:text="@string/purpose_escape"
                    android:textColor="@color/white" />
            </RadioGroup>

            <!-- section ta3 taswira (optionnelle): button upload + apercu -->
            <TextView
                android:id="@+id/tv_label_photo_yr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter"
                android:text="@string/label_photo"
                android:textColor="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- apercu ta3 taswira li khtarha el user -->
                <ImageView
                    android:id="@+id/iv_photo_preview_yr"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_photo_frame"
                    android:contentDescription="@string/photo_desc"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_traveler_photo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_photo_yr"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:onClick="fctPickPhoto"
                    android:text="@string/btn_upload_photo"
                    android:textColor="@color/gold"
                    app:backgroundTint="@color/input_dark"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/gold"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_inspect_yr"
            android:onClick="fctInspect"
            android:layout_width="271dp"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/inter"
            android:text="@string/btn_inspect"
            android:textAllCaps="true"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:backgroundTint="@color/gold"
            app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>